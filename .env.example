PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# ==================== SUPABASE DATABASE ====================
# PostgreSQL Database URLs from Supabase
# Get these from: https://app.supabase.com/project/[your-project]/settings/database
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:[YOUR_PORT]/postgres?schema=public
DIRECT_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:[YOUR_PORT]/postgres

# Supabase URLs for Frontend Authentication
# Get these from: https://app.supabase.com/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_ANON_KEY]

# Supabase Service Role Key (Backend only - keep secure!)
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]

# ==================== JWT & SECURITY ====================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ==================== EMAIL SERVICE ====================
# Gmail SMTP Configuration
# Setup guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: Resend Email Service
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=noreply@smartops.ai

# ==================== AI CONFIGURATION ====================
# Groq API for AI Assistant
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key
AI_PROVIDER=groq

# ==================== OAUTH CONFIGURATION ====================
# GitHub OAuth
# Create app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# Google OAuth
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
